# ── Required ───────────────────────────────────────────────────────────────
# Postgres connection (Neon / Netlify DB / Supabase / RDS). Netlify DB sets NETLIFY_DATABASE_URL automatically.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Encrypts OAuth refresh tokens at rest: openssl rand -hex 32
ENCRYPTION_KEY=
# Shared secret between the scheduler and the background worker: openssl rand -hex 24
INTERNAL_API_SECRET=
# Public URL of the site (Netlify sets URL automatically; set APP_URL if you use a custom domain)
APP_URL=https://remail.netlify.app

# First administrator, created on first start when no users exist
ADMIN_EMAIL=vikas.rungta@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Vikas Rungta

# Organisation
ORG_NAME=Wheel King TransHaul
INTERNAL_DOMAINS=wheelking.com,wheelkingtranshaul.com
ALERT_RECIPIENTS=

# ── Sign-in (same mechanism as rfleet) ─────────────────────────────────────
# local | ravity | both. Default: both when RAVITY_IAM_URL is set, otherwise local.
AUTH_MODE=
# Same value as rfleet's REACT_APP_SERVICE_URL (the Ravity IAM base URL)
RAVITY_IAM_URL=
# Customer space name in Ravity IAM (rfleet uses REACT_APP_SPACE_NAME)
RAVITY_SPACE_NAME=remail
RAVITY_DEFAULT_ROLE=viewer
BOOTSTRAP_ADMIN_EMAILS=

# ── AI analysis (one of these; without any, built-in rules are used) ───────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Azure OpenAI (keeps processing inside your Azure tenant)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Microsoft 365 (Entra ID app registration) ──────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: tenant for delegated "Connect Outlook" sign-ins (default: common)
MS_DELEGATED_TENANT=common
# Optional: dedicated mailbox to send alerts and reports from (needs Mail.Send on that mailbox only)
MS_SENDER_MAILBOX=

# ── Gmail (Google Cloud OAuth client) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Outbound email for alerts and reports (pick one) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=remail <remail@notifications.ravity.io>

# ── Chat alerts (optional) ────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Tuning (optional) ─────────────────────────────────────────────────────
SESSION_HOURS=12
ALERT_LOOKBACK_HOURS=72
DB_POOL_MAX=4
