# ── Required ───────────────────────────────────────────────────────────────
# Postgres connection (Neon / Netlify DB / Supabase / RDS). Netlify DB sets NETLIFY_DATABASE_URL automatically.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Encrypts OAuth refresh tokens at rest: openssl rand -hex 32
ENCRYPTION_KEY=
# Shared secret between the scheduler and the background worker: openssl rand -hex 24
INTERNAL_API_SECRET=
# Public URL of the site (Netlify sets URL automatically; set APP_URL if you use a custom domain)
APP_URL=https://remail.netlify.app

# First administrator, created on first start when no users exist
ADMIN_EMAIL=vikas.rungta@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Vikas Rungta

# Organisation
ORG_NAME=Wheel King TransHaul
INTERNAL_DOMAINS=wheelking.com,wheelkingtranshaul.com
ALERT_RECIPIENTS=

# ── Sign-in (same mechanism as rfleet) ─────────────────────────────────────
# local | ravity | both. Default: both when RAVITY_IAM_URL is set, otherwise local.
AUTH_MODE=
# Same value as rfleet's REACT_APP_SERVICE_URL (the Ravity backend base URL)
RAVITY_IAM_URL=
# Customer space name in Ravity IAM — same as rfleet's REACT_APP_SPACE_NAME, or a dedicated remail space
RAVITY_SPACE_NAME=
RAVITY_DEFAULT_ROLE=viewer
BOOTSTRAP_ADMIN_EMAILS=

# ── AI analysis (one of these; without any, built-in rules are used) ───────
# Google Gemini (default provider when the key is set). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.8-flash (recommended) · gemini-3.5-flash-lite (cheapest) · gemini-3.1-pro-preview (deepest)
GEMINI_MODEL=gemini-3.8-flash
# gemini | anthropic | azure | openai | heuristic (blank = first one with a key, Gemini first)
AI_PROVIDER=gemini
# Gemini free tier: pace requests (6000 ≈ 10/minute). Leave 0 with billing enabled.
AI_MIN_INTERVAL_MS=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Azure OpenAI (keeps processing inside your Azure tenant)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Microsoft 365 (Entra ID app registration — see docs/MICROSOFT_365_SETUP.md) ──
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# organizations (default) or your tenant id to restrict sign-in / Connect my Outlook to one tenant
MS_DELEGATED_TENANT=organizations
# Optional: fixed customer tenant; normally set by the in-app administrator consent instead
MS_TENANT_ID=
# Sign in with Microsoft (on by default when MS_CLIENT_ID/SECRET are set)
MS_SSO=true
MS_SSO_ALLOWED_DOMAINS=ravity.io,wheelking.com
MS_SSO_DEFAULT_ROLE=analyst
# Sign in with Microsoft also connects the person's own inbox read-only (set false for sign-in only)
MS_SIGNIN_CONNECTS_MAILBOX=true
SIGNIN_BACKFILL_DAYS=30
# Optional: dedicated mailbox to send alerts and reports from (needs Mail.Send on that mailbox only)
MS_SENDER_MAILBOX=

# ── Gmail (Google Cloud OAuth client) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Outbound email for alerts and reports (pick one) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=remail <remail@notifications.ravity.io>

# ── Chat alerts (optional) ────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Tuning (optional) ─────────────────────────────────────────────────────
SESSION_HOURS=12
ALERT_LOOKBACK_HOURS=72
# Local hour (per user's timezone) for the My day email
DIGEST_LOCAL_HOUR=7
DB_POOL_MAX=4
